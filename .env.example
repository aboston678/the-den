# Copy this file to .env and fill in real values. Never commit .env.
# Local development works with no .env at all; these defaults are built in.

# --- Website (client) — public values, safe in the browser ---
# Where the browser finds the game server.
VITE_SERVER_URL=http://localhost:2567
# Phase 2 (Google sign-in):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Game server — keep secret ---
PORT=2567
# Comma-separated websites allowed to connect (add the Vercel URL when deployed).
ALLOWED_ORIGINS=http://localhost:5173
# Phase 2 (server-only, NEVER put this in a VITE_ variable):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
