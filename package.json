{
  "name": "the-den",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fetch:clips": "node tools/fetch-clips.mjs",
    "build:bear": "node tools/build-bear.mjs",
    "build:outdoor": "node tools/fetch-polyhaven.mjs && node tools/build-outdoor-textures.mjs && node tools/build-outdoor-props.mjs && node --import ./tools/lib/register-asset-imports.mjs tools/build-trees.mjs",
    "build:audio": "node tools/fetch-audio.mjs && node tools/build-audio.mjs && node tools/build-music.mjs",
    "build:tv": "node tools/build-tv.mjs",
    "build:furniture": "node tools/build-furniture.mjs",
    "build:fish": "node tools/build-furniture.mjs --fish",
    "build:bike": "node tools/build-bike.mjs",
    "build:toon": "node tools/build-toon-textures.mjs && node tools/build-toon-scenery.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
